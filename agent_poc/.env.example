# From your instance URL https://dev123456.service-now.com, use: dev123456
SN_INSTANCE=
# An integration user with the itil role only. Never admin.
SN_USER=
SN_PASSWORD=
# Signs session tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Optional: route with Liquid's managed d1 instead of the local service
# LIQUID_API_KEY=liquid_...
