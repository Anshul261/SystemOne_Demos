# System Two: any OpenAI-compatible endpoint. Cerebras serves Qwen3.8-27B.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.cerebras.ai/v1
TEXT_MODEL=qwen-3.8-27b
# System One: leave TYPESAFE_API_KEY empty to use d1 on the local service (../start-d1.sh).
TYPESAFE_API_KEY=
D1_URL=http://127.0.0.1:8020
D1_MODEL=3b
# OpenEMR, for --target openemr. Use a non-admin clinician account.
OPENEMR_URL=
OPENEMR_USER=
OPENEMR_PASSWORD=
